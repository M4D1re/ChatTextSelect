{
  "schemaVersion": 1,
  "id": "chattextselect",
  "version": "${version}",
  "name": "Chat Text Select",
  "description": "Позволяет выделять мышью и копировать текст из игрового чата.",
  "authors": ["MrDire"],
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "ru.mrdire.chatselect.ChatTextSelectClient"
      }
    ]
  },
  "mixins": [
    "chattextselect.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.1",
    "fabric-language-kotlin": "*",
    "minecraft": "1.21.11"
  }
}